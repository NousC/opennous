# ── Start here ────────────────────────────────────────────────────────────────
# Bundled self-host (docker-compose.selfhost.yaml, its own database and auth): you only
# set the three domains below and one AI key (OPENROUTER_API_KEY, or ANTHROPIC_API_KEY).
# Then `node scripts/selfhost-keys.mjs nous.env` fills in everything else: the database
# password, JWT secret, Supabase URLs and keys, ENCRYPTION_KEY, WORKER_SECRET, the setup
# token and COMPOSE_FILE. The Supabase and Clerk sections are for running against an
# external Supabase project (and Nous Cloud); leave them as they are for the bundled stack.
# Guide: docs/self-host-bundled.md
#
# Host ports: Caddy listens on 80 and 443. Set these when those are taken. Every link the
# app builds is https://$APP_DOMAIN (no port), so a non-443 HTTPS port needs something in
# front that serves it on 443.
# HTTP_PORT=80
# HTTPS_PORT=443

# ── Domains (used by Caddy for SSL + routing) ─────────────────────────────────
# These two also drive OAuth redirects, webhook callbacks, and email links:
# the app derives APP_URL=https://$APP_DOMAIN and API_URL=https://$API_DOMAIN
# from them automatically (see apps/api/src/bootEnv.mjs). Set APP_URL / API_URL
# explicitly only if your app and API live somewhere other than these domains.
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
# Hosted MCP server (Streamable HTTP). Point a DNS record at the server; Caddy
# auto-provisions TLS. Remote MCP clients (n8n cloud, etc.) connect to https://$MCP_DOMAIN/mcp
MCP_DOMAIN=mcp.yourdomain.com

# ── Supabase (database + self-host auth) ─────────────────────────────────────
# Get these from your Supabase project → Settings → API. Supabase is the app
# database, and on a self-hosted instance it also signs your users in
# (Supabase Auth). Nothing else is needed for auth.
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Recommended: Settings → API → JWT Secret (legacy HS256 secret). With it set the
# API verifies every session token locally, no network call per request. Without
# it (or on a project using asymmetric signing keys) the API asks Supabase.
SUPABASE_JWT_SECRET=

# ── Auth provider ─────────────────────────────────────────────────────────────
# AUTH_PROVIDER=supabase|clerk. Unset, it follows SELF_HOSTED below:
# SELF_HOSTED=true → supabase, otherwise → clerk. Self-hosters leave it unset.
# AUTH_PROVIDER=supabase

# ── Frontend (baked into JS bundle at build time) ──────────────────────────────
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# VITE_AUTH_PROVIDER=supabase|clerk. Unset: clerk when VITE_CLERK_PUBLISHABLE_KEY
# is set, supabase otherwise. Keep it in step with the API's AUTH_PROVIDER.
# VITE_AUTH_PROVIDER=supabase

# ── Clerk (Nous Cloud only) ───────────────────────────────────────────────────
# Cloud authenticates with Clerk. Self-host: leave both unset.
# Get these from the Clerk dashboard → API keys. The API verifies Clerk session
# tokens and runs admin user ops (delete / impersonate) through the Backend API.
# Recommended: customize the session token (Clerk → Sessions → Edit) to include
#   { "email": "{{user.primary_email_address}}", "name": "{{user.full_name}}" }
# so the API can provision new users without an extra Backend API call.
# CLERK_SECRET_KEY=sk_test_...
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── AI ───────────────────────────────────────────────────────────────────────
# One OpenRouter key runs every job below, Claude models included (recommended). Without it, an id
# starting with claude- runs on ANTHROPIC_API_KEY, and any other id on the OpenAI-compatible
# endpoint LLM_BASE_URL names (OpenAI, Groq, Together, LiteLLM, a local Ollama), keyed by
# LLM_API_KEY. Settings → Instance setup shows what runs where and recommended setups.
# Guide: docs/self-host-bundled.md#ai-models
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_BASE_URL=
# LLM_API_KEY=
# EXTRACTION_MODEL=claude-haiku-4-5-20251001     # reading calls and email
# WRITING_MODEL=z-ai/glm-5.2                     # summaries and reports (falls back to EXTRACTION_MODEL)
# INSIGHT_BOARD_MODEL=anthropic/claude-haiku-4.5 # the Insights board

# ── Auth / Security ───────────────────────────────────────────────────────────
# Random 32-byte hex string — used to encrypt OAuth tokens at rest
ENCRYPTION_KEY=
# Random 32-byte hex string shared by the api and the worker for their internal calls
# (deal overview, account summary refresh, automations, backfill after a connect).
# Unset, those features stay off. scripts/selfhost-keys.mjs and ./update.sh fill it in.
WORKER_SECRET=

# ── Self-host ─────────────────────────────────────────────────────────────────
# Master self-host switch. Set this on every self-hosted instance.
#
# SELF_HOSTED=true gives you the graph, unmetered and uncapped: Accounts,
# Activities, the ICP file, the Graph, all 20+ integrations, webhooks, and the
# full API/MCP surface. No account limit, no billing, no plan enforcement.
# Extraction runs on YOUR ANTHROPIC_API_KEY, which is exactly why there's nothing
# to meter — your graph costs us nothing to fill.
#
# It is the Self-serve plan: CRM sync with HubSpot and Salesforce, lead lists,
# webhooks and automations included. It does NOT include the Workspace layer
# (the in-app agent, Tasks, Skills, reports and the Slack connector).
# See CLOUD_ONLY_FEATURES in apps/api/src/lib/access.mjs.
#
# ⚠️ On Nous Cloud this MUST be unset. Leaving it true disables billing entirely
# and hands every customer the whole product for free.
SELF_HOSTED=true

# DISABLE_SIGNUPS=true closes public registration: the FIRST account created
# becomes the owner, and after that nobody can self-register. Add teammates with
# a join link (Settings → Team → Create invite). Leave unset/false for an open
# instance. The bundled stack (scripts/selfhost-keys.mjs) sets it to true.
#
# Belt-and-suspenders: also turn OFF "Allow new users to sign up" in your
# Supabase project (Authentication → Sign In / Providers) — that shuts the door
# at the auth layer too, since signup goes browser → Supabase directly.
# DISABLE_SIGNUPS=true

# ── Cloud / team features (optional for self-host) ────────────────────────────
# Skip these for a single-tenant self-host. They power features that the
# hosted Nous Cloud uses, and most self-hosters do not need them.
#
# SIGNAL_HMAC_SECRET signs per-workspace tokens for RB2B / Signalbase ingest.
# Only needed if you ingest from RB2B or Signalbase.
SIGNAL_HMAC_SECRET=

# RESEND_API_KEY sends workspace invitation emails. Only needed if you
# invite teammates to your workspace. Without it, invites still create
# accounts, but no email is sent.
RESEND_API_KEY=
# If you set RESEND_API_KEY, also set the sender to an address on YOUR Resend
# verified domain — otherwise the send is rejected. Reply-to defaults to the
# from address when left blank.
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# ── Platform operator allowlists (cloud only — LEAVE EMPTY FOR SELF-HOST) ──────
# These gate the platform-operator surface (CMS, Roadmap, Changelog, Updates,
# Resources) and VIP plan access. Both are EMPTY by default, which means NO
# account can ever reach the admin surface on a self-hosted instance — this is
# intentional. Only the hosted Nous Cloud sets these. Comma-separated emails.
# ADMIN_EMAILS=founder@example.com
# VIP_EMAILS=founder@example.com

# ── CORS (comma-separated allowed origins) ────────────────────────────────────
# Leave unset to allow all origins (fine for self-hosted / local dev).
# Set this on cloud to lock down to your frontend domain.
# CORS_ORIGINS=https://app.opennous.cloud

# ── Integrations ─────────────────────────────────────────────────────────────
# Google OAuth — Gmail + Google Calendar with your own Google Cloud OAuth client (Web
# application). Members click "Connect with Google" on the Integrations page; no Composio
# needed. Register https://<API_DOMAIN>/api/oauth/google/callback on the OAuth client. Leave
# GOOGLE_OAUTH_REDIRECT_URI as is (or empty) to derive it from API_DOMAIN. Scopes asked:
# openid, userinfo.email, gmail.readonly (Gmail), calendar.readonly (Calendar).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.yourdomain.com/api/oauth/google/callback

# Slack OAuth — for DM polling
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://api.yourdomain.com/api/oauth/slack/callback

# Salesforce OAuth — setup guide: docs/providers/salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=https://api.yourdomain.com/api/workflow-providers/salesforce/oauth/callback
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# Unipile — for LinkedIn webhook
UNIPILE_API_KEY=
UNIPILE_DSN=

# Enrichment providers
PROSPERO_API_KEY=

# Let workspaces WITHOUT their own Prospeo key enrich on the platform key above.
# This is Nous's money, so it is OFF unless you set it to exactly "true".
# Leave it unset in production: enrichment is not a product we sell, and
# resolveContact fires enrichment on every contact a webhook creates, so an open
# fallback is an unbounded bill. Customers with their own Prospeo key are
# unaffected either way.
ENRICHMENT_BUILTIN_FALLBACK=
OPENAI_API_KEY=

# Semantic search's background embedding sweep, every 2 minutes. OFF unless set to exactly
# "true". It is off by default because it took production down on 2026-09-21: no overlap
# guard, a query no index could answer, 167-second runs stacking three deep on a 2-minute
# cron, and the Accounts page queued behind them.
#
# Both faults are fixed, but turn it on IN THIS ORDER or you reintroduce the scan:
#   1. apply supabase/migrations/2026_09_21_embedding_queue_indexes.sql
#   2. deploy the worker (stays off — nothing changes)
#   3. set this to "true" and restart the worker
#   4. check worker_runs for `embeddings`: sub-second, no errors
# Leaving it off costs you only search freshness; structured retrieval is unaffected.
EMBEDDINGS_ENABLED=

# ── Webhook secrets (shared secret to validate inbound webhook payloads) ─────────
# Set these to a random string and configure the same value in each integration's dashboard.
# Only the integrations you actually connect need a secret — leave the rest blank.
LINKEDIN_WEBHOOK_SECRET=
INSTANTLY_WEBHOOK_SECRET=
CALENDLY_WEBHOOK_SECRET=
FIREFLIES_WEBHOOK_SECRET=
FATHOM_WEBHOOK_SECRET=
RB2B_WEBHOOK_SECRET=
# Outbound sequencers (reply/bounce ingestion for Lead Lists)
HEYREACH_WEBHOOK_SECRET=
LEMLIST_WEBHOOK_SECRET=
SMARTLEAD_WEBHOOK_SECRET=
EMAILBISON_WEBHOOK_SECRET=

# ── Optional: outbound form-notification webhooks ────────────────────────────────
# In-app "feedback"/"idea" submissions and landing-page waitlist signups can be
# forwarded to an automation endpoint (e.g. n8n / Zapier / Make). Both are OPTIONAL:
# if unset the forms still work — feedback is accepted, the waitlist still posts to
# the app — they just aren't forwarded. Keeps any private endpoint out of source.
FEEDBACK_WEBHOOK_URL=
# Read at BUILD time by the frontend, so it MUST keep the VITE_ prefix.
VITE_WAITLIST_WEBHOOK_URL=
# Where the app's "Contact us" links go (build time). Unset: https://opennous.cloud.
# VITE_CONTACT_URL=https://example.com/contact

# ── Optional: weekly LinkedIn engagement run (Scale plan) ─────────────────────
# When APIFY_TOKEN is set, the worker scrapes engagers off each connected
# workspace's own recent LinkedIn posts every Monday into a native
# "LinkedIn Engagers" lead list. Unset → the whole feature is off.
APIFY_TOKEN=
# Force-enable specific workspaces regardless of plan (dogfood / pilots), CSV.
LINKEDIN_ENGAGEMENT_WORKSPACES=
# Tuning (optional): scrape window, max posts/run, profile depth ('main'|'short').
# ENGAGEMENT_WINDOW_DAYS=7
# ENGAGEMENT_MAX_POSTS=5
# ENGAGEMENT_PROFILE_MODE=main

# ── Optional: Stripe (cloud / hosted only) ────────────────────────────────────
# Leave blank for self-hosted. Set these to enable billing UI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Separate secret for the inbound Stripe-event ingestion webhook (dogfood signals).
STRIPE_INBOUND_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# ── Monitoring / alerting ──────────────────────────────────────────────────────
# Slack incoming-webhook URL for operator alerts (API/worker crashes, /readyz DB
# failures, dead-lettered webhooks). Leave blank to log-only. Create one at
# https://api.slack.com/messaging/webhooks. Point an external uptime monitor
# (UptimeRobot / BetterStack) at https://api.<domain>/readyz — it 503s when the DB is down.
OPS_ALERT_SLACK_WEBHOOK=
# Sentry DSN for error grouping/search/alerting (api + worker). Leave blank to disable —
# the SDK is dynamically imported only when this is set, so no cost when unused.
SENTRY_DSN=
# The one self-serve plan: API, $199/mo. Create a recurring $199/mo Price in Stripe and
# paste its price_... id here. Required for the API plan checkout to work on cloud.
STRIPE_API_PRICE_ID=
# Retired self-serve tiers — only needed to keep any grandfathered subscriptions billing.
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# ── Optional: analytics & monitoring ─────────────────────────────────────────
# Company logos (Google's favicon service) and people's Gravatar photos are on by default.
# They are third-party requests that tell Google and Gravatar which domains and hashed emails
# are in your workspace; false turns them off and shows initials instead. Rebuild the
# frontend after changing it: docker compose --env-file nous.env up -d --build frontend
# VITE_EXTERNAL_IMAGES=false

# PostHog project token (phc_..., public by design) and its ingest host. Leave the key
# empty and the app sends nothing. Host defaults to https://us.i.posthog.com; EU projects
# use https://eu.i.posthog.com.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_GOOGLE_ANALYTICS_ID=

# ── Optional: docs link override ──────────────────────────────────────────────
# Where the in-app "Docs" links point. Defaults to https://docs.opennous.cloud.
VITE_DOCS_URL=

# ── VITE_API_URL ──────────────────────────────────────────────────────────────
# Leave empty when using the nginx same-domain proxy (single domain, no Caddy).
# Set to https://api.yourdomain.com when api is on a separate subdomain (Caddy / cloud).
# VITE_API_URL=https://api.yourdomain.com

# ── Optional: port (default 80) — only used when running WITHOUT Caddy ─────────
# PORT=80

# ── Optional: default timezone ────────────────────────────────────────────────
# An IANA zone (e.g. America/New_York, Europe/Berlin). Used to read the calendar
# date a commitment was made on, so a spoken deadline ("by Friday", "tomorrow")
# resolves against the speaker's day rather than UTC's. A call at 5pm Pacific is
# already the next day in UTC, so leaving this unset shifts those deadlines by
# one. Defaults to UTC.
# NOUS_DEFAULT_TIMEZONE=America/New_York
